# Science Tokyo LMS MCP 設定例
# このファイルを .env にコピーして利用する (.env はコミットしない)．

# Science Tokyo ポータルの URL
STLMS_PORTAL_URL=https://portal.isct.ac.jp/

# Moodle (Science Tokyo LMS) のベース URL．年度ごとにパスが分かれる点に注意．
# 例: 2025 年度なら https://lms.s.isct.ac.jp/2025/
STLMS_LMS_BASE_URL=https://lms.s.isct.ac.jp/2025/

# トークン取得に用いるブラウザエンジン (chromium / firefox / webkit)
STLMS_BROWSER=chromium

# トークンの保存方式 (auto / keyring / file)
#   auto    : keyring を試し，失敗時はファイルへ退避 (既定)
#   file    : keyring を使わず .auth/wstoken に保存 (keyring が使えない環境向け)
#   keyring : keyring のみ
STLMS_TOKEN_BACKEND=auto

# トークンを直接指定する場合 (任意．設定すると最優先で使われる)
# STLMS_WSTOKEN=

# Playwright 永続プロファイルの保存先 (SSO セッションを保持)
# STLMS_USER_DATA_DIR=.auth/profile

# 講義資料のダウンロード先
STLMS_DOWNLOAD_DIR=downloads

# トークン取得 (初回ログイン) 時のヘッドレス実行可否．手動ログイン時は false 推奨
STLMS_HEADLESS=false
